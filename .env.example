# --- Proxmox connection -----------------------------------------------------
# IP or hostname only (a pasted https://host:8006 URL is also accepted)
PROXMOX_HOST=192.168.1.21
PROXMOX_PORT=8006

# --- Auth mode 1: API token (recommended) -----------------------------------
PROXMOX_USER=root@pam
# Token ID only, e.g. "mcp" (the full "root@pam!mcp" also works)
PROXMOX_TOKEN_NAME=mcp
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Auth mode 2: password (used only when no token is set) -----------------
# PROXMOX_PASSWORD=

# --- Behaviour --------------------------------------------------------------
# true only if Proxmox has a trusted (non self-signed) certificate
PROXMOX_VERIFY_SSL=false
# true hides all write tools and blocks write API calls
PROXMOX_READ_ONLY=false
# Request timeout in ms
PROXMOX_TIMEOUT=30000
# Limit exposed modules (empty = all):
# access,backup,cluster,firewall,ha,lxc,nodes,pools,qemu,sdn,storage,guest-services
PROXMOX_MODULES=

# --- HTTP mode only (bun start) ---------------------------------------------
HOST=127.0.0.1
PORT=3000
# Required to listen on anything other than localhost
PROXMOX_MCP_AUTH_TOKEN=
