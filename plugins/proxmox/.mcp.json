{
  "mcpServers": {
    "proxmox": {
      "command": "npx",
      "args": ["-y", "@amailath/proxmox-mcp-server@2.1.0", "--stdio"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_HOST": "${user_config.host}",
        "CLAUDE_PLUGIN_OPTION_TOKEN_ID": "${user_config.token_id}",
        "CLAUDE_PLUGIN_OPTION_TOKEN_SECRET": "${user_config.token_secret}",
        "CLAUDE_PLUGIN_OPTION_VERIFY_SSL": "${user_config.verify_ssl}",
        "CLAUDE_PLUGIN_OPTION_READ_ONLY": "${user_config.read_only}",
        "CLAUDE_PLUGIN_OPTION_MODULES": "${user_config.modules}"
      }
    }
  }
}
