{
  "name": "proxmox-mcp-server",
  "version": "1.0.0",
  "description": "Enterprise-grade Proxmox VE Model Context Protocol (MCP) server in TypeScript, Elysia, and Bun",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "proxmox-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "proxmox",
    "mcp",
    "elysia",
    "bun",
    "typescript",
    "model-context-protocol"
  ],
  "author": "Antigravity Studio",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@sinclair/typebox": "^0.34.28",
    "dotenv": "^16.4.7",
    "elysia": "^1.2.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^5.7.3"
  }
}
